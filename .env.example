# Copy this file to `.env` and fill in your values. Both apps read the repo-root `.env`.
# Frontend (Vite) only sees variables prefixed with VITE_.

# PostGIS (used by `docker compose up`)
POSTGRES_DB=geoai
POSTGRES_USER=geoai
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Backend database URL (reserved for future persistence)
DATABASE_URL=postgresql://geoai:change-me@localhost:5432/geoai

# Backend CORS: comma-separated origins allowed to call the API
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Frontend Mapbox access token (reserved; the current build does not use it)
VITE_MAPBOX_ACCESS_TOKEN=

# Copernicus Data Space (CDSE) credentials — required for Sentinel-2 imagery tiles.
# Register free at https://dataspace.copernicus.eu/, then create an OAuth client
# (profile → settings → OAuth clients) and copy its id/secret here.
# Without these, /api/v1/tiles/sentinel2/... returns 503 and imagery stays blank.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
